{
  "name": "crm-ui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron_dev": "concurrently \"npm electron\" \"wait-on http://localhost:3000 && electron .\"",
    "electron_build": "react-scripts build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.ar_infotech.FlowupS",
    "productName": "FlowupS Desktop App",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.2.2",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "dnd-kit": "^0.0.2",
    "dotenv": "^17.4.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.6.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.14.0",
    "react-toastify": "^11.0.5",
    "react-window": "^1.8.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.8",
    "wait-on": "^9.0.5"
  }
}
